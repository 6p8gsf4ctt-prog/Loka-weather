{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loka-weather",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "observability": { "enabled": true },
  "vars": {
    "OPEN_METEO_BASE_URL": "https://api.open-meteo.com/v1/forecast",
    "WEEKLY_CONTEXTUAL_SLIDES_ENABLED": "true",
    "WEEKLY_ENABLED": "true",
    "WEEKLY_PROGRESSIVE_PUBLICATION_ENABLED": "true",
    "WEEKLY_PROGRESSIVE_ROLLBACK": "false",
    "WEEKLY_PROGRESSIVE_SHADOW_MODE": "false",
    "DAILY_INSIGHT_STORY_ENABLED": "true",
    "DAILY_INSIGHT_STORY_ROLLBACK": "false",
    "DAILY_INSIGHT_CPU_BUDGET_MS": "20"
  },
  "triggers": {
    "crons": [
      "15 * * * *",
      "45 2 * * *",
      "45 3 * * *",
      "45 4 * * *",
      "45 5 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loka-weather",
      "database_id": "23c60a13-a134-40c9-b38e-2435e7fed368",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false
  }
}
