{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loka-weather",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "observability": { "enabled": true },
  "vars": {
    "OPEN_METEO_BASE_URL": "https://api.open-meteo.com/v1/forecast",
    "PUBLIC_BASE_URL": "https://loka-weather.jpbm62n289.workers.dev"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": [
      "45 3 * * *",
      "45 4 * * *",
      "45 5 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loka-weather",
      "database_id": "23c60a13-a134-40c9-b38e-2435e7fed368",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INSTAGRAM_MEDIA",
      "bucket_name": "loka-instagram-v3-media"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false
  }
}
